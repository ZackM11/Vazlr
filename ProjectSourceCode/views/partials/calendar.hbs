<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-12 pt-1">
            <div class="bg-light">
                <div class="card-body">
                    <div class="d-flex">
                        <h5 class="pt-2 calendar-title">Event Calendar</h5>
                        <div class="ms-auto">
                            <button class="btn btn-primary bg-warning" onclick="goToToday()">Today</button>
                            <button class="btn btn-primary bg-warning" onclick="updateViewToWeek()">Week
                                View</button>
                            <button class="btn btn-primary bg-warning" onclick="updateViewToMonth()">Month
                                View</button>
                            <button class="btn btn-primary bg-warning" onclick="goToPrevious()">&lsaquo;</button>
                            <button class="btn btn-primary bg-warning" onclick="goToNext()">&rsaquo;</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center pt-2">
        <table class="table table-bordered week-view">
            <thead class="week-heading">
                <tr>
                    <th scope="col">Sunday</th>
                    <th scope="col">Monday</th>
                    <th scope="col">Tuesday</th>
                    <th scope="col">Wednesday</th>
                    <th scope="col">Thursday</th>
                    <th scope="col">Friday</th>
                    <th scope="col">Saturday</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Place sunday events</td>
                    <td>Place monday events</td>
                    <td>Place tuesday events</td>
                    <td>Place wednesday events</td>
                    <td>Place thursday events</td>
                    <td>Place friday events</td>
                    <td>Place saturday events</td>
                </tr>
            </tbody>
        </table>
        <table class="table table-bordered month-view" style="display: none;">
            <thead>
                <tr>
                    <th scope="col">Sun</th>
                    <th scope="col">Mon</th>
                    <th scope="col">Tue</th>
                    <th scope="col">Wed</th>
                    <th scope="col">Thu</th>
                    <th scope="col">Fri</th>
                    <th scope="col">Sat</th>
                </tr>
            </thead>
            <tbody>
                <!-- Placeholder for month view events, you can dynamically generate the days of the month here -->
            </tbody>
        </table>
    </div>
</div>
<script>
    // Custom JavaScript for the calendar can go here
    const calendarTable = document.querySelector('table');
    const weekView = document.querySelector('.week-view');
    const weekHeading = document.querySelector('.week-heading');
    const monthView = document.querySelector('.month-view');
    const calendarTitle = document.querySelector('.calendar-title');
    const now = new Date();

    const currDay = now.toLocaleDateString();
    const startOfWeek = getWeekStartSunday();
    const startOfMonth = getMonthCurrentMonth();

    let currweek = startOfWeek;
    let currmonth = startOfMonth;

    let currview = 'week';
    if (currview === 'week') {
        updateViewToWeek();
    } else {
        updateViewToMonth();
    }
    function getMonthCurrentMonth() {
        const now = new Date();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        return mm;
    }
    function getWeekStartSunday() {
        const now = new Date();
        const day = now.getDay(); // 0 (Sun) - 6 (Sat)
        const diff = now.getDate() - day; // Adjust to Sunday
        const sunday = new Date(now.setDate(diff));

        // Format as MM/DD
        const mm = String(sunday.getMonth() + 1).padStart(2, '0');
        const dd = String(sunday.getDate()).padStart(2, '0');
        return `${mm}/${dd}`;
    }
    function getMonthStart() {
        return getWeekStartSunday().slice(0, 2);
    }
    function updateViewToMonth() {
        currview = 'month';
        updateCalendarTitle();
        monthView.style.display = 'table';
        weekView.style.display = 'none';
        fillInMonthView();
        highlightCurrentDay();
    }
    function updateCalendarTitle() {
        const month = now.toLocaleString(undefined, { month: 'long' });
        calendarTitle.textContent = `Event Calendar - ${month}`;
    }
    function fillInMonthView() {
        const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
        const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        const daysInMonth = monthEnd.getDate();

        const firstDayOfWeek = monthStart.getDay(); // 0 (Sun) - 6 (Sat)
        const lastDayOfWeek = monthEnd.getDay(); // 0 (Sun) - 6 (Sat)

        let html = '<tr>';
        // Fill in empty cells for the first week
        for (let i = 0; i < firstDayOfWeek; i++) {
            html += '<td></td>';
        }

        // Fill in the days of the month
        for (let day = 1; day <= daysInMonth; day++) {
            html += `<td data-day="${day}">${day}</td>`;
            if ((firstDayOfWeek + day) % 7 === 0) {
                html += '</tr><tr>'; // Start a new row after Saturday
            }
        }

        // Fill in empty cells for the last week
        for (let i = lastDayOfWeek + 1; i < 7; i++) {
            html += '<td></td>';
        }
        html += '</tr>';

        monthView.querySelector('tbody').innerHTML = html;
    }
    function updateViewToWeek() {
        currview = 'week';
        updateCalendarTitle();
        weekView.style.display = 'table';
        monthView.style.display = 'none';

        const sunday = new Date(now);
        sunday.setDate(now.getDate() - now.getDay());
        const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        weekHeading.innerHTML = `
                <tr>
                    ${days.map((day, index) => {
            const date = new Date(sunday);
            date.setDate(sunday.getDate() + index);
            const shortDate = `${String(date.getMonth() + 1).padStart(2, '0')}/${String(date.getDate()).padStart(2, '0')}`;
            return `<th scope="col">${day} ${shortDate}</th>`;
        }).join('')}
                </tr>`;
        highlightCurrentDay();
        // Update the calendar table to show the week view
    }
    function highlightCurrentDay() {
        const today = new Date();
        weekView.querySelectorAll('th, td').forEach(cell => {
            cell.style.removeProperty('--bs-table-bg');
        });
        monthView.querySelectorAll('td').forEach(cell => {
            cell.style.removeProperty('--bs-table-bg');
        });

        if (currview === 'week') {
            const weekStart = new Date(now);
            weekStart.setDate(now.getDate() - now.getDay());
            const weekEnd = new Date(weekStart);
            weekEnd.setDate(weekStart.getDate() + 7);

            if (today >= weekStart && today < weekEnd) {
                weekView.querySelectorAll('tr').forEach(row => {
                    const cell = row.cells[today.getDay()];
                    if (cell) {
                        cell.style.setProperty('--bs-table-bg', '#ffc107');
                    }
                });
            }
        } else if (now.getFullYear() === today.getFullYear() &&
            now.getMonth() === today.getMonth()) {
            const todayCell = monthView.querySelector(`[data-day="${today.getDate()}"]`);
            if (todayCell) {
                todayCell.style.setProperty('--bs-table-bg', '#ffc107');
            }
        }
    }
    function goToToday() {
        now.setTime(new Date().getTime());
        if (currview === 'week') {
            updateViewToWeek();
        } else {
            updateViewToMonth();
        }
    }
    function goToPrevious() {
        if (currview === 'week') {
            const prevWeek = new Date(now);
            prevWeek.setDate(now.getDate() - 7);
            now.setTime(prevWeek.getTime());
            updateViewToWeek();
        } else {
            const prevMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
            now.setTime(prevMonth.getTime());
            updateViewToMonth();
        }
    }
    function goToNext() {
        if (currview === 'week') {
            const nextWeek = new Date(now);
            nextWeek.setDate(now.getDate() + 7);
            now.setTime(nextWeek.getTime());
            updateViewToWeek();
            highlightCurrentDay();
        } else {
            const nextMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1);
            now.setTime(nextMonth.getTime());
            updateViewToMonth();
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>