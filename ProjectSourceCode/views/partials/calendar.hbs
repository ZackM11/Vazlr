<!-- For testing (Please don't remove): SkibidiPartialCalendarIncluded67 -->
<div class="container event-calendar"
    data-can-edit-events="{{#if canEditEvents}}true{{else}}false{{/if}}">
    <div class="row justify-content-center">
        <div class="col-md-12 pt-1">
            <div class="bg-light">
                <div class="card-body">
                    <div class="d-flex">
                        <h5 class="pt-2 calendar-title">Event Calendar</h5>
                        <div class="ms-auto calendar-controls">
                            <button class="btn calendar-action" type="button" onclick="goToToday()">
                                Today
                            </button>
                            <button class="btn calendar-action" type="button" onclick="updateViewToWeek()">
                                Week View
                            </button>
                            <button class="btn calendar-action" type="button" onclick="updateViewToMonth()">
                                Month View
                            </button>
                            <button class="btn calendar-action calendar-nav" type="button" aria-label="Previous"
                                onclick="goToPrevious()">
                                &lsaquo;
                            </button>
                            <button class="btn calendar-action calendar-nav" type="button" aria-label="Next"
                                onclick="goToNext()">
                                &rsaquo;
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center pt-2">
        <table class="table week-view calendar-grid">
            <thead class="week-heading">
                <tr>
                    <th scope="col">Sunday</th>
                    <th scope="col">Monday</th>
                    <th scope="col">Tuesday</th>
                    <th scope="col">Wednesday</th>
                    <th scope="col">Thursday</th>
                    <th scope="col">Friday</th>
                    <th scope="col">Saturday</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
        <table class="table month-view calendar-grid" style="display: none">
            <thead>
                <tr>
                    <th scope="col">Sun</th>
                    <th scope="col">Mon</th>
                    <th scope="col">Tue</th>
                    <th scope="col">Wed</th>
                    <th scope="col">Thu</th>
                    <th scope="col">Fri</th>
                    <th scope="col">Sat</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    <div class="calendar-event-data" hidden aria-hidden="true">
        {{#each events}}
        <span data-event-id="{{id}}" data-event-title="{{title}}" data-event-start="{{start_time}}"
            data-event-end="{{end_time}}" data-event-description="{{description}}" data-event-address="{{address}}"
            data-event-city="{{city}}" data-event-zip="{{zip}}" data-event-capacity="{{capacity}}"
            data-event-category="{{category_id}}" data-event-image="{{image_url}}" data-event-status="{{status}}"></span>
        {{/each}}
    </div>
</div>
<script>
    const calendarRoot = document.currentScript.previousElementSibling;
    const weekView = calendarRoot.querySelector(".week-view");
    const weekHeading = calendarRoot.querySelector(".week-heading");
    const monthView = calendarRoot.querySelector(".month-view");
    const calendarTitle = calendarRoot.querySelector(".calendar-title");
    const currentDate = new Date();
    const events = Array.from(calendarRoot.querySelectorAll(".calendar-event-data span"))
        .map((event) => ({
            id: event.dataset.eventId,
            title: event.dataset.eventTitle,
            start: new Date(event.dataset.eventStart),
            end: new Date(event.dataset.eventEnd),
            description: event.dataset.eventDescription,
            address: event.dataset.eventAddress,
            city: event.dataset.eventCity,
            zip: event.dataset.eventZip,
            capacity: event.dataset.eventCapacity,
            category: event.dataset.eventCategory,
            image: event.dataset.eventImage,
            status: event.dataset.eventStatus,
        }))
        .filter((event) => !Number.isNaN(event.start.getTime()) && !Number.isNaN(event.end.getTime()));
    let currview = "week";

    function dateKey(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
    }

    function getWeekStart(date) {
        const sunday = new Date(date);
        sunday.setDate(date.getDate() - date.getDay());
        sunday.setHours(0, 0, 0, 0);
        return sunday;
    }

    function updateCalendarTitle() {
        calendarTitle.textContent = `Event Calendar - ${currentDate.toLocaleString(undefined, {
            month: "long",
            year: "numeric",
        })}`;
    }

    function createDayCell(date, showDayNumber) {
        const cell = document.createElement("td");
        cell.dataset.date = dateKey(date);
        if (showDayNumber) {
            const dayNumber = document.createElement("div");
            dayNumber.className = "calendar-day-number";
            dayNumber.textContent = date.getDate();
            cell.appendChild(dayNumber);
        }
        return cell;
    }

    function addEventsToCells() {
        const eventsByDate = new Map();
        events.forEach((event) => {
            const eventDate = new Date(event.start);
            eventDate.setHours(0, 0, 0, 0);
            const lastEventDate = new Date(event.end);
            lastEventDate.setHours(0, 0, 0, 0);

            while (eventDate <= lastEventDate) {
                const key = dateKey(eventDate);
                if (!eventsByDate.has(key)) {
                    eventsByDate.set(key, []);
                }
                eventsByDate.get(key).push(event);
                eventDate.setDate(eventDate.getDate() + 1);
            }
        });

        calendarRoot.querySelectorAll(".calendar-grid td[data-date]").forEach((cell) => {
            const cellEvents = eventsByDate.get(cell.dataset.date) || [];
            cellEvents.forEach((event) => {
                const canEditEvents = calendarRoot.dataset.canEditEvents === "true";
                const eventItem = document.createElement(canEditEvents ? "button" : "div");
                if (canEditEvents) {
                    eventItem.type = "button";
                    eventItem.dataset.eventId = event.id;
                    eventItem.setAttribute("aria-label", `Edit ${event.title}`);
                    eventItem.addEventListener("click", () => {
                        calendarRoot.dispatchEvent(new CustomEvent("calendar-event-selected", {
                            bubbles: true,
                            detail: event,
                        }));
                    });
                }
                eventItem.className = "calendar-event";

                const eventTime = document.createElement("time");
                eventTime.dateTime = event.start.toISOString();
                eventTime.textContent = event.start.toLocaleTimeString(undefined, {
                    hour: "numeric",
                    minute: "2-digit",
                });
                const endTime = document.createElement("time");
                endTime.dateTime = event.end.toISOString();
                endTime.textContent = event.end.toLocaleTimeString(undefined, {
                    hour: "numeric",
                    minute: "2-digit",
                });
                eventItem.append(
                    eventTime,
                    document.createTextNode(" – "),
                    endTime,
                );
                const eventTitle = document.createElement("span");
                eventTitle.className = "calendar-event-title";
                eventTitle.textContent = event.title;
                eventItem.appendChild(eventTitle);
                cell.appendChild(eventItem);
            });
        });
    }

    function highlightCurrentDay() {
        weekHeading.querySelectorAll("th[data-date]").forEach((heading) => {
            heading.classList.toggle("is-today", heading.dataset.date === dateKey(new Date()));
        });
    }

    function updateViewToMonth() {
        currview = "month";
        updateCalendarTitle();
        monthView.style.display = "table";
        weekView.style.display = "none";
        fillInMonthView();
    }

    function fillInMonthView() {
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();
        const monthStart = new Date(year, month, 1);
        const monthEnd = new Date(year, month + 1, 0);
        const lastSaturday = new Date(monthEnd);
        lastSaturday.setDate(monthEnd.getDate() + (6 - monthEnd.getDay()));
        const cursor = getWeekStart(monthStart);
        const tbody = monthView.querySelector("tbody");

        tbody.replaceChildren();
        while (cursor <= lastSaturday) {
            const row = document.createElement("tr");
            for (let day = 0; day < 7; day += 1) {
                row.appendChild(createDayCell(cursor, true));
                cursor.setDate(cursor.getDate() + 1);
            }
            tbody.appendChild(row);
        }
        addEventsToCells();
    }

    function updateViewToWeek() {
        currview = "week";
        updateCalendarTitle();
        weekView.style.display = "table";
        monthView.style.display = "none";

        const sunday = getWeekStart(currentDate);
        const headingRow = document.createElement("tr");
        const weekRow = document.createElement("tr");
        const tbody = weekView.querySelector("tbody");

        for (let day = 0; day < 7; day += 1) {
            const date = new Date(sunday);
            date.setDate(sunday.getDate() + day);
            const heading = document.createElement("th");
            heading.scope = "col";
            heading.dataset.date = dateKey(date);
            const dateLabel = document.createElement("span");
            dateLabel.className = "calendar-date-label";
            dateLabel.textContent = `${date.toLocaleDateString(undefined, {
                weekday: "long",
            })} ${date.toLocaleDateString(undefined, {
                month: "2-digit",
                day: "2-digit",
            })}`;
            heading.appendChild(dateLabel);
            headingRow.appendChild(heading);
            weekRow.appendChild(createDayCell(date, false));
        }

        weekHeading.replaceChildren(headingRow);
        tbody.replaceChildren(weekRow);
        addEventsToCells();
        highlightCurrentDay();
    }

    function goToToday() {
        currentDate.setTime(new Date().getTime());
        if (currview === "week") {
            updateViewToWeek();
        } else {
            updateViewToMonth();
        }
    }
    function goToPrevious() {
        if (currview === "week") {
            currentDate.setDate(currentDate.getDate() - 7);
            updateViewToWeek();
        } else {
            currentDate.setDate(1);
            currentDate.setMonth(currentDate.getMonth() - 1);
            updateViewToMonth();
        }
    }
    function goToNext() {
        if (currview === "week") {
            currentDate.setDate(currentDate.getDate() + 7);
            updateViewToWeek();
        } else {
            currentDate.setDate(1);
            currentDate.setMonth(currentDate.getMonth() + 1);
            updateViewToMonth();
        }
    }

    updateViewToWeek();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>