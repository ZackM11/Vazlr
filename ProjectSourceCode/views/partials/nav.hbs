<header>
    <nav class="navbar navbar-expand-sm border-bottom bg-warning">
        <div class="container">
            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbar-collapse" aria-controls="navbar" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <img src="/img/VAZLR-logo.png" alt="VAZLR Logo" class="img-fluid nav-branch" style="max-height: 40px;">
                    </li>
                </ul>
                <div class="nav-item me-1">
					{{#if user}}
					<form action="/logout" method="POST">
						<button type="submit" name="logout" class="btn btn-sign-up rounded-3 py-2">Log out</button>
					</form>
					{{/if}}
                </div>
            </div>
        </div>
    </nav>
</header>
