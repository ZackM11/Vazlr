<!DOCTYPE html>
<html lang="en">

	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Volunteer Page | Vazlr</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
																					   integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
	</head>


	<body>
		<div class="container my-5" style ="max-width: 720px;">
			{{#if error}}
				<div class="alert alert-danger" role="alert">{{error}}</div>
			{{/if}}


			<div class="card mb-4 shadow-sm">
				<div class="card-body">
					<h2 class="card-title h4 mb-1">{{event.title}}</h2>
					{{#if event.open}}
						<span class="text-success fw-semibold">✓ Open</span>
					{{else}}
						<span class="text-danger fw-semibold">✗ Closed</span>
					{{/if}}
					<p  class="text-muted mb-2">
						Hosted by {{event.org_name}}
						{{#if event.is_verified}}<span class="text-success fw-semibold">✓ Verified</span>{{/if}}
					</p>
					{{#if event.description}}
						<div class="py-3">
							{{event.description}}
						</div>
					{{/if}}
					<p class="mb-1"><strong>When: </strong>{{event.start_time}} <strong>to</strong> {{event.end_time}}</p>
					<p class="mb-1"><strong>Where:</strong> {{event.address}}, {{event.city}}, {{event.zip}}</p>
					{{#if event.capacity}}
						<p class="mb-0"><strong>Spots left:</strong> {{event.capacity}}</p>
					{{/if}}
				</div>
			</div>

			<div class="card shadow-sm">
				<div class="card body">
					<h3 class="h5 mb-3">Sign up for this event!</h3>

					<form action="book-event" method="POST">
						<input type="hidden" name="event_id" value="{{event.id}}">
						<div class="mb-3">
							<label for="name" class="form-label">Full name</label>
							<input type="text" class="form-control" id="name" name="name" required maxlength="100">
						</div>

						<div class="mb-3">
							<label for="email" class="form-label">Email</label>
							<input type="email" class="form-control" id="email" name="email" value="{{user.email}}" required maxlength="100">
						</div>

						<div class="mb-3">
							<label for="emergencyPhone" class="form-label">Emergency Contact Phone</label>
							<input type="tel" class="form-control" id="ermegencyPhone" name="emergencyPhone" required maxlength="20">
						</div>

						<div class="mb-3">
							<label for="emergencyName" class="form-label">Emergency Contact Name</label>
							<input type="text" class="form-control" id="emergencyName" name="emergencyName" required maxlength="100">
						</div>

						<div class="mb-3">
							<label for="notes" class="form-label">Anything the organizer should know? <span class="text-muted">(optional)</span></label>
							<textarea class="form-control" id="notes" name="notes" rows="3" maxlength="500"></textarea>
						</div>

						<div class="form-check mb-4">
							<input class="form-check-input" type="checkbox" id="commit" name="commit" required>
							<label class="form-check-label" for="commit">
								I commit to showing up (no-shows may get banned)
							</label>
						</div>

						<div class="d-flex gap-2">
							<button type="submit" class="btn btn-primary">Confirm sign-up</button>
							<a href="dashboard" class="btn btn-outline-secondary">Cancel</a>
						</div>
					</form>
				</div>
			</div>
		</div>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
		  integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
	crossorigin="anonymous"></script> 
	</body>

