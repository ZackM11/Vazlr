<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Organization Dashboard | Vazlr</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
		integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
	<link href="/css/dashboard.css" rel="stylesheet" />
</head>

<body class="dashboard-page">
	<div class="container-fluid p-0">
		<div class="row g-0 dashboard-shell">
			<aside class="col-md-3 col-xl-2 dashboard-sidebar" aria-label="Organization dashboard navigation">
				<p class="sidebar-label">Workspace</p>
				<nav class="d-grid gap-1">
					<a class="sidebar-link" href="#events">Events</a>
					<a class="sidebar-link" href="#volunteers">Volunteers</a>
					<a class="sidebar-link" href="#calendar">Calendar</a>
				</nav>

				<div class="sidebar-actions">
					<button class="btn btn-create-event rounded-3 py-2" type="button" data-bs-toggle="modal"
						data-bs-target="#createEventModal">
						Create event
					</button>
				</div>
			</aside>

			<main class="col-md-9 col-xl-10">
				<div class="dashboard-main">
					<header class="mb-4 mb-lg-5">
						<p class="eyebrow mb-1">Organization dashboard</p>
						<h1 class="welcome-title">
							Welcome back, organizer
						</h1>
						<p class="welcome-copy mb-0">
							Keep your community events and volunteers moving
							forward.
						</p>
					</header>

					<div class="row g-3 g-lg-4 mb-3 mb-lg-4">
						<section class="col-lg-6" id="events" aria-labelledby="events-title">
							<div class="card dashboard-card">
								<div class="card-body">
									<div class="d-flex justify-content-between align-items-start mb-2">
										<div>
											<h2 class="section-title" id="events-title">
												Event list
											</h2>
											<p class="section-subtitle small mb-0 mt-1">
												Your upcoming community
												events
											</p>
										</div>
										<span class="badge rounded-pill text-bg-light">{{events.length}} events</span>
									</div>
									<ul class="list-group list-group-flush">
										{{#each events}}
										<li class="list-group-item event-item">
											<span class="list-indicator" aria-hidden="true"></span>{{title}}
											<span class="list-meta float-end">{{status}}</span>
										</li>
										{{else}}
										<li class="list-group-item list-meta">
											You have no events yet.
										</li>
										{{/each}}
									</ul>
									{{#if showAllEvents}}
									<button id="showAllEvents" class="btn btn-link px-0 mt-2" type="button"
										aria-expanded="false">
										Show all {{events.length}}
									</button>
									{{/if}}
								</div>
							</div>
						</section>

						<section class="col-lg-6" id="volunteers" aria-labelledby="volunteers-title">
							<div class="card dashboard-card">
								<div class="card-body">
									<div class="d-flex justify-content-between align-items-start mb-2">
										<div>
											<h2 class="section-title" id="volunteers-title">
												Volunteer Sign-ups
											</h2>
											<p class="section-subtitle small mb-0 mt-1">
												People supporting your
												events
											</p>
										</div>
										<span class="badge rounded-pill text-bg-light">{{volunteers.length}} volunteers</span>
									</div>
									<ul class="list-group list-group-flush">
										{{#each volunteers}}
										<li class="list-group-item">
											<span class="volunteer-signup" data-volunteer-index="{{@index}}">
												<span class="list-indicator" aria-hidden="true"></span>{{first_name}} {{last_name}}
												<span class="list-meta float-end">{{event_title}}</span>
											</span>
										</li>
										{{else}}
										<li class="list-group-item list-meta">No volunteers have signed up yet.</li>
										{{/each}}
									</ul>
									{{#if showAllVolunteers}}
									<button id="showAllVolunteers" class="btn btn-link px-0 mt-2" type="button"
										aria-expanded="false">
										Show all {{volunteers.length}}
									</button>
									{{/if}}
								</div>
							</div>
						</section>
					</div>

					<section class="card dashboard-card calendar-card" id="calendar" aria-label="Event calendar">
						<div class="card-body">{{> calendar}}</div>
					</section>
				</div>
			</main>
		</div>
	</div>

	<div class="modal fade" id="createEventModal" tabindex="-1" aria-labelledby="createEventModalLabel"
		aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content border-0 rounded-4">
				<div class="modal-header border-0 pb-0">
					<h2 class="modal-title fs-5 fw-bold" id="createEventModalLabel">
						Create an event
					</h2>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body pt-2">
					<h1 class="modal-title fs-4 fw-bold mb-3">
						Create an event
					</h1>
					<form id="createEventForm" action="/orgs/events" method="post">
						<div id="createEventFeedback" class="alert d-none" role="alert" aria-live="polite"></div>
						<div class="mb-3">
							<label for="eventName" class="form-label">Event Title</label>
							<input type="text" class="form-control" id="eventName" name="eventName" required />
						</div>
						<div class="mb-3">
							<label for="eventStart" class="form-label">Start Date and Time</label>
							<input type="datetime-local" class="form-control" id="eventStart" name="eventStart"
								required />
						</div>
						<div class="mb-3">
							<label for="eventDescription" class="form-label">Event Description</label>
							<textarea class="form-control" id="eventDescription" name="eventDescription" rows="3"
								required></textarea>
						</div>
						<div class="mb-3">
							<label for="eventAddress" class="form-label">Address</label>
							<input type="text" class="form-control" id="eventAddress" name="eventAddress" required />
						</div>
						<div class="mb-3">
							<label for="eventCity" class="form-label">City</label>
							<input type="text" class="form-control" id="eventCity" name="eventCity" required />
						</div>
						<div class="mb-3">
							<label for="eventZip" class="form-label">Zip Code</label>
							<input type="text" class="form-control" id="eventZip" name="eventZip" required />
						</div>
						<div class="mb-3">
							<label for="eventEnd" class="form-label">End Date and Time</label>
							<input type="datetime-local" class="form-control" id="eventEnd" name="eventEnd" required />
						</div>
						<div class="mb-3">
							<label for="eventCapacity" class="form-label">Capacity</label>
							<input type="number" class="form-control" id="eventCapacity" name="eventCapacity"
								required />
						</div>
						<div class="mb-3">
							<label for="eventCategory" class="form-label">Category</label>
							<select class="form-select" id="eventCategory" name="eventCategory" required>
								<option value="" disabled selected>
									Select a category
								</option>
								<option value="1">Environment</option>
								<option value="2">Food & Hunger</option>
								<option value="3">Education</option>
								<option value="4">Animal Welfare</option>
								<option value="5">Health & Wellness</option>
								<option value="6">Community</option>
								<option value="7">Arts & Culture</option>
								<option value="8">Seniors</option>
							</select>
						</div>
						<div class="mb-3">
							<label for="eventImage" class="form-label">Event Image URL (optional)</label>
							<input type="url" class="form-control" id="eventImage" name="eventImage" />
						</div>
						<div class="mb-3">
							<label for="eventStatus" class="form-label">Status</label>
							<select class="form-select" id="eventStatus" name="eventStatus" required>
								<option value="open">Open</option>
								<option value="cancelled">Cancelled</option>
							</select>
						</div>
						<button id="createEventSubmit" type="submit" class="btn btn-primary rounded-3 px-4">
							Create Event
						</button>
					</form>
				</div>
				<div class="modal-footer border-0 pt-0">
					<button type="button" class="btn btn-dark rounded-3 px-4" data-bs-dismiss="modal">
						Close
					</button>
				</div>
			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
		integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
		crossorigin="anonymous"></script>
	<script>
		const createEventForm = document.getElementById("createEventForm");
		const createEventFeedback = document.getElementById("createEventFeedback");
		const createEventSubmit = document.getElementById("createEventSubmit");
		const eventStart = document.getElementById("eventStart");
		const eventEnd = document.getElementById("eventEnd");
		const showAllEvents = document.getElementById("showAllEvents");
		const eventItems = document.querySelectorAll(".event-item");
		const showAllVolunteers = document.getElementById("showAllVolunteers");
		const volunteerSignups = document.querySelectorAll(".volunteer-signup");

		if (showAllEvents) {
			eventItems.forEach((item, index) => {
				if (index >= 5) {
					item.hidden = true;
				}
			});

			showAllEvents.addEventListener("click", () => {
				const expanded = showAllEvents.getAttribute("aria-expanded") === "true";
				eventItems.forEach((item, index) => {
					if (index >= 5) {
						item.hidden = expanded;
					}
				});
				showAllEvents.setAttribute("aria-expanded", String(!expanded));
				showAllEvents.textContent = expanded
					? "Show all {{events.length}}"
					: "Show fewer";
			});
		}

		if (showAllVolunteers) {
			volunteerSignups.forEach((signup, index) => {
				if (index >= 5) {
					signup.closest("li").hidden = true;
				}
			});

			showAllVolunteers.addEventListener("click", () => {
				const expanded = showAllVolunteers.getAttribute("aria-expanded") === "true";
				volunteerSignups.forEach((signup, index) => {
					if (index >= 5) {
						signup.closest("li").hidden = expanded;
					}
				});
				showAllVolunteers.setAttribute("aria-expanded", String(!expanded));
				showAllVolunteers.textContent = expanded
					? "Show all {{volunteers.length}}"
					: "Show fewer";
			});
		}

		eventStart.addEventListener("change", () => {
			eventEnd.min = eventStart.value;
		});

		createEventForm.addEventListener("submit", async (event) => {
			event.preventDefault();
			createEventFeedback.className = "alert d-none";
			createEventFeedback.textContent = "";
			createEventSubmit.disabled = true;

			try {
				const formData = new FormData(createEventForm);
				for (const fieldName of ["eventStart", "eventEnd"]) {
					const localDateTime = formData.get(fieldName);
					if (typeof localDateTime !== "string" || !localDateTime) {
						throw new Error("Enter both the event start and end times.");
					}

					formData.set(fieldName, new Date(localDateTime).toISOString());
				}

				const response = await fetch(createEventForm.action, {
					method: createEventForm.method,
					headers: {
						"Accept": "application/json",
						"Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
					},
					body: new URLSearchParams(formData),
				});
				const result = await response.json();

				if (!response.ok) {
					const fieldErrors = Object.values(result.errors || {}).flat();
					throw new Error(fieldErrors.join(" ") || result.message || "Unable to create the event.");
				}

				createEventFeedback.className = "alert alert-success";
				createEventFeedback.textContent = result.message || "Event created successfully.";
				createEventForm.reset();
				eventEnd.removeAttribute("min");
			} catch (error) {
				createEventFeedback.className = "alert alert-danger";
				createEventFeedback.textContent = error instanceof Error
					? error.message
					: "Unable to create the event. Please try again.";
			} finally {
				createEventSubmit.disabled = false;
			}
		});
	</script>
</body>

</html>