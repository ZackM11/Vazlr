<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="/css/booking.css">

<div class="booking-page">
  <div class="container" style="max-width: 480px;">

    <div class="text-center mb-4">
      <h1 class="h3 mb-1">Join VAZLR</h1>
      <p class="text-muted mb-0">Connect humans to work for humanity in a few clicks.</p>
    </div>

    {{#if error}}
      <div class="alert alert-danger" role="alert">{{error}}</div>
    {{/if}}

    <div class="card shadow-sm">
      <div class="card-body">
        <form action="/register" method="POST">

          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" name="username"
                   value="{{username}}" required maxlength="50">
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email"
                   value="{{email}}" required maxlength="100">
          </div>

          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password"
                   required minlength="8" maxlength="100">
            <div class="form-text">At least 8 characters.</div>
          </div>

          <div class="mb-3">
            <label for="confirm_password" class="form-label">Confirm password</label>
            <input type="password" class="form-control" id="confirm_password" name="confirm_password"
                   required minlength="8" maxlength="100">
          </div>

          {{!-- Volunteer or organization: decides which dashboard they go to after login --}}
          <div class="mb-4">
            <p class="form-label mb-2">I'm signing up as a...</p>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="role" id="role-volunteer" value="volunteer" checked>
              <label class="form-check-label" for="role-volunteer">Volunteer (hero)</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="role" id="role-org" value="organization">
              <label class="form-check-label" for="role-org">Organization (generous philanthropist)</label>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100">Create account</button>

        </form>
      </div>
    </div>

    <p class="text-center text-muted mt-3 mb-0">
      Already have an account? <a href="/login">Log in</a>
    </p>

  </div>
</div>