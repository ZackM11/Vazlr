<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login | Vazlr</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/css/dashboard.css" rel="stylesheet">
</head>

<main class="container"> <!-- Centers the content and adds side padding -->
{{> message}}
<body> 
  <div class="row justify-content-center"> <!-- Centers the column -->
    <div class="col-md-6"> <!-- Half-width column on medium+ screens -->

      <h1>Login</h1> <!-- heading says Login -->

      <form action="/login" method="POST"> <!-- submitting now calls POST /login -->

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="text" class="form-control" id="email" name="email" required /> <!-- name="email" is what the server reads -->
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" required /> <!-- name="password"; type="password" hides the characters -->
        </div>

        <button type="submit" class="btn btn-primary">Login</button> 
      </form>

      <p class="mt-3">Don't have an account? <a href="/register">Register</a></p> 
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</main>
</body>  
