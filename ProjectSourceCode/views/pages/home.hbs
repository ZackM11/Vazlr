<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link href="/css/dashboard.css" rel="stylesheet">
<div class="dashboard-page">
    <div class="container-fluid p-0">
        <div class="row g-0 dashboard-shell">
            <main class="col-12">
                <div class="dashboard-main">
                    <section class="mb-4 mb-lg-5">
                        <p class="eyebrow mb-1">Good things happen together</p>
                        <h1 class="welcome-title">Make a difference in your community</h1>
                        <p class="welcome-copy mb-3">Find meaningful local events, bring volunteers together, and turn
                            good intentions into action.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-dark rounded-3 px-4 py-2" href="/volunteers/register">Explore volunteer features</a>
                            <a class="btn btn-outline-dark rounded-3 px-4 py-2" href="/orgs/register">Organize with Vazlr</a>
                        </div>
                    </section>

                    <section class="mb-4 mb-lg-5" id="organization" aria-labelledby="organization-title">
                        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                            <div>
                                <p class="eyebrow mb-1">For organizations</p>
                                <h2 class="section-title fs-4" id="organization-title">Bring your events together</h2>
                                <p class="section-subtitle mb-0 mt-1">Tools to plan events and coordinate volunteers.</p>
                            </div>
                            <a class="btn btn-create-event rounded-3 px-3 py-2" href="/orgs/login">Organization dashboard</a>
                        </div>

                        <div class="row g-3 g-lg-4">
                            <article class="col-md-4">
                                <div class="card dashboard-card">
                                    <div class="card-body">
                                        <h3 class="section-title">Create events</h3>
                                        <p class="section-subtitle small mt-2 mb-0">Set up and share events for your community.</p>
                                    </div>
                                </div>
                            </article>
                            <article class="col-md-4">
                                <div class="card dashboard-card">
                                    <div class="card-body">
                                        <h3 class="section-title">Manage event listings</h3>
                                        <p class="section-subtitle small mt-2 mb-0">Keep your organization's events organized in one dashboard.</p>
                                    </div>
                                </div>
                            </article>
                            <article class="col-md-4">
                                <div class="card dashboard-card">
                                    <div class="card-body">
                                        <h3 class="section-title">Coordinate volunteers</h3>
                                        <p class="section-subtitle small mt-2 mb-0">View volunteer signups and keep your team connected.</p>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </section>

                    <section class="mb-4 mb-lg-5" id="opportunities" aria-labelledby="opportunities-title">
                        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                            <div>
                                <p class="eyebrow mb-1">For volunteers</p>
                                <h2 class="section-title fs-4" id="opportunities-title">Find ways to get involved</h2>
                                <p class="section-subtitle mb-0 mt-1">Discover opportunities that fit your interests and schedule.</p>
                            </div>
                            <a class="btn btn-outline-dark rounded-3 px-3 py-2" href="/volunteers/dashboard">Volunteer dashboard</a>
                        </div>

                        <div class="row g-3 g-lg-4">
                            <article class="col-md-4">
                                <div class="card dashboard-card">
                                    <div class="card-body">
                                        <h3 class="section-title">Browse event calendar</h3>
                                        <p class="section-subtitle small mt-2 mb-0">Explore upcoming events in a calendar view.</p>
                                    </div>
                                </div>
                            </article>
                            <article class="col-md-4">
                                <div class="card dashboard-card">
                                    <div class="card-body">
                                        <h3 class="section-title">Discover opportunities</h3>
                                        <p class="section-subtitle small mt-2 mb-0">Find events hosted by organizations in your community.</p>
                                    </div>
                                </div>
                            </article>
                            <article class="col-md-4">
                                <div class="card dashboard-card">
                                    <div class="card-body">
                                        <h3 class="section-title">Sign up to help</h3>
                                        <p class="section-subtitle small mt-2 mb-3">Choose events to support and keep track of your signups.</p>
                                        <a class="btn btn-create-event rounded-3 px-3 py-2" href="/volunteers/register">Get started</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </div>
