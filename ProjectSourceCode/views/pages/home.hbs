<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link href="/css/dashboard.css" rel="stylesheet">

<style>
    /* ---------- Theme tokens (yellow is sampled from the header: #ffc107) ---------- */
    :root {
        --vz-yellow: #ffc107;
        --vz-yellow-hover: #ffcd38;
        --vz-ink: #0b0b0b;

        --vz-bg: #ffffff;
        --vz-surface: #ffffff;
        --vz-text: #0b0b0b;
        --vz-muted: #4a4a4a;
        --vz-border: #0b0b0b;
        --vz-card-shadow: var(--vz-yellow);
        --vz-focus: #0b0b0b;

        --vz-btn-outline-text: #0b0b0b;
        --vz-btn-outline-border: #0b0b0b;
        --vz-btn-outline-bg: #ffffff;
    }

    :root[data-bs-theme="dark"] {
        --vz-bg: #000000;
        --vz-surface: #0f0f0f;
        --vz-text: #ffffff;
        --vz-muted: #b0b0b0;
        --vz-border: #3a3a3a;
        --vz-card-shadow: var(--vz-yellow);
        --vz-focus: #ffc107;

        --vz-btn-outline-text: #ffc107;
        --vz-btn-outline-border: #ffc107;
        --vz-btn-outline-bg: transparent;
    }

    /* Page background and footer follow the theme (header stays yellow in both modes) */
    :root[data-bs-theme] body {
        background-color: var(--vz-bg);
        color: var(--vz-text);
    }

    :root[data-bs-theme] footer,
    :root[data-bs-theme] footer a {
        background-color: transparent;
        color: var(--vz-muted);
    }

    /* ---------- Layout ---------- */
    .vz-home {
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
        padding: clamp(1.75rem, 4vw, 3.5rem) clamp(1rem, 4vw, 2.5rem) 3rem;
        color: var(--vz-text);
    }

    .vz-section + .vz-section {
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .vz-hero-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .vz-section-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    /* ---------- Typography ---------- */
    .vz-eyebrow {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin: 0 0 .5rem;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--vz-text);
    }

    .vz-eyebrow::before {
        content: "";
        width: 1.5rem;
        height: .3rem;
        border-radius: 99px;
        background: var(--vz-yellow);
        flex: none;
    }

    .vz-title {
        margin: 0 0 .75rem;
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -.025em;
        color: var(--vz-text);
    }

    .vz-mark {
        background: linear-gradient(transparent 60%, var(--vz-yellow) 60%);
        padding: 0 .1em;
        color: var(--vz-text);
    }

    :root[data-bs-theme="light"] .vz-mark,
    :root:not([data-bs-theme]) .vz-mark {
        color: var(--vz-ink);
    }

    .vz-lead {
        max-width: 54rem;
        margin: 0 0 1.5rem;
        font-size: 1.125rem;
        color: var(--vz-muted);
    }

    .vz-section-title {
        margin: 0;
        font-size: clamp(1.5rem, 3vw, 1.9rem);
        font-weight: 800;
        letter-spacing: -.02em;
        color: var(--vz-text);
    }

    .vz-section-sub {
        margin: .35rem 0 0;
        color: var(--vz-muted);
    }

    /* ---------- Buttons: one shape, one size, two variants ---------- */
    .vz-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .vz-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .65rem 1.4rem;
        border: 2px solid var(--vz-ink);
        border-radius: .75rem;
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease, color .12s ease;
    }

    .vz-btn-primary {
        background: var(--vz-yellow);
        color: var(--vz-ink);
        border-color: var(--vz-ink);
        box-shadow: 0 3px 0 var(--vz-ink);
    }

    :root[data-bs-theme="dark"] .vz-btn-primary {
        border-color: var(--vz-yellow);
        box-shadow: none;
    }

    .vz-btn-primary:hover {
        background: var(--vz-yellow-hover);
        color: var(--vz-ink);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--vz-ink);
    }

    :root[data-bs-theme="dark"] .vz-btn-primary:hover {
        box-shadow: 0 4px 0 rgba(255, 193, 7, .35);
    }

    .vz-btn-outline {
        background: var(--vz-btn-outline-bg);
        color: var(--vz-btn-outline-text);
        border-color: var(--vz-btn-outline-border);
    }

    .vz-btn-outline:hover {
        background: var(--vz-yellow);
        border-color: var(--vz-yellow);
        color: var(--vz-ink);
        transform: translateY(-2px);
    }

    :root[data-bs-theme="light"] .vz-btn-outline:hover,
    :root:not([data-bs-theme]) .vz-btn-outline:hover {
        border-color: var(--vz-ink);
    }

    .vz-btn:active {
        transform: translateY(0);
        box-shadow: none;
    }

    .vz-btn:focus-visible,
    .vz-theme-toggle:focus-visible {
        outline: 3px solid var(--vz-focus);
        outline-offset: 3px;
    }

    /* ---------- Cards: identical structure, no buttons inside ---------- */
    .vz-card {
        position: relative;
        height: 100%;
        padding: 1.5rem;
        background: var(--vz-surface);
        border: 2px solid var(--vz-border);
        border-radius: 1rem;
        box-shadow: 5px 5px 0 var(--vz-card-shadow);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    .vz-card::before {
        content: "";
        display: block;
        width: 2.25rem;
        height: .3rem;
        margin-bottom: 1rem;
        border-radius: 99px;
        background: var(--vz-yellow);
    }

    :root[data-bs-theme="light"] .vz-card::before,
    :root:not([data-bs-theme]) .vz-card::before {
        background: var(--vz-ink);
    }

    .vz-card:hover {
        transform: translate(-2px, -2px);
        box-shadow: 8px 8px 0 var(--vz-card-shadow);
    }

    :root[data-bs-theme="dark"] .vz-card:hover {
        border-color: var(--vz-yellow);
    }

    .vz-card-title {
        margin: 0 0 .4rem;
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -.01em;
        color: var(--vz-text);
    }

    .vz-card-text {
        margin: 0;
        font-size: .95rem;
        color: var(--vz-muted);
    }

    /* ---------- Theme toggle ---------- */
    .vz-theme-toggle {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        border: 2px solid var(--vz-border);
        border-radius: 50%;
        background: var(--vz-surface);
        color: var(--vz-text);
        cursor: pointer;
        transition: background-color .12s ease, border-color .12s ease, transform .12s ease;
    }

    :root[data-bs-theme="dark"] .vz-theme-toggle {
        border-color: var(--vz-yellow);
        color: var(--vz-yellow);
    }

    .vz-theme-toggle:hover {
        background: var(--vz-yellow);
        border-color: var(--vz-ink);
        color: var(--vz-ink);
        transform: rotate(15deg);
    }

    .vz-theme-toggle svg {
        width: 1.25rem;
        height: 1.25rem;
    }

    .vz-theme-toggle .vz-icon-sun { display: none; }
    :root[data-bs-theme="dark"] .vz-theme-toggle .vz-icon-sun { display: block; }
    :root[data-bs-theme="dark"] .vz-theme-toggle .vz-icon-moon { display: none; }

    @media (prefers-reduced-motion: reduce) {
        .vz-home * {
            transition: none !important;
        }
    }
</style>

<script>
    /* Apply the saved (or system) theme before the page content paints */
    (function () {
        var theme = null;
        try { theme = localStorage.getItem('vazlr-theme'); } catch (e) { /* storage unavailable */ }
        if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', theme);
    })();
</script>

<div class="vz-home">
    <main>
        <section class="vz-section" aria-labelledby="hero-title">
            <div class="vz-hero-top">
                <div>
                    <p class="vz-eyebrow">Good things happen together</p>
                    <h1 class="vz-title" id="hero-title">Make a <span class="vz-mark">difference</span> in your community</h1>
                    <p class="vz-lead">Find meaningful local events, bring volunteers together, and turn good
                        intentions into action.</p>
                </div>
                <button type="button" class="vz-theme-toggle" id="vz-theme-toggle" aria-label="Switch to dark mode">
                    <svg class="vz-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    <svg class="vz-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                </button>
            </div>
            <div class="vz-actions">
                <a class="vz-btn vz-btn-primary" href="/login">Log into your Minion Dashboard</a>
                <a class="vz-btn vz-btn-outline" href="/login">Log into your Organization Dashboard</a>
            </div>
        </section>

        <section class="vz-section" id="organization" aria-labelledby="organization-title">
            <div class="vz-section-head">
                <div>
                    <p class="vz-eyebrow">For organizations</p>
                    <h2 class="vz-section-title" id="organization-title">Bring your events together</h2>
                    <p class="vz-section-sub">Tools to plan events and coordinate volunteers.</p>
                </div>
                <a class="vz-btn vz-btn-primary" href="/register">Get started</a>
            </div>

            <div class="row g-3 g-lg-4">
                <article class="col-md-4">
                    <div class="vz-card">
                        <h3 class="vz-card-title">Create events</h3>
                        <p class="vz-card-text">Set up and share events for your community.</p>
                    </div>
                </article>
                <article class="col-md-4">
                    <div class="vz-card">
                        <h3 class="vz-card-title">Manage event listings</h3>
                        <p class="vz-card-text">Keep your organization's events organized in one dashboard.</p>
                    </div>
                </article>
                <article class="col-md-4">
                    <div class="vz-card">
                        <h3 class="vz-card-title">Coordinate volunteers</h3>
                        <p class="vz-card-text">View volunteer signups and keep your team connected.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="vz-section" id="opportunities" aria-labelledby="opportunities-title">
            <div class="vz-section-head">
                <div>
                    <p class="vz-eyebrow">For volunteers</p>
                    <h2 class="vz-section-title" id="opportunities-title">Find ways to get involved</h2>
                    <p class="vz-section-sub">Discover opportunities that fit your interests and schedule.</p>
                </div>
                <a class="vz-btn vz-btn-primary" href="/register">Get started</a>
            </div>

            <div class="row g-3 g-lg-4">
                <article class="col-md-4">
                    <div class="vz-card">
                        <h3 class="vz-card-title">Browse event calendar</h3>
                        <p class="vz-card-text">Explore upcoming events in a calendar view.</p>
                    </div>
                </article>
                <article class="col-md-4">
                    <div class="vz-card">
                        <h3 class="vz-card-title">Discover opportunities</h3>
                        <p class="vz-card-text">Find events hosted by organizations in your community.</p>
                    </div>
                </article>
                <article class="col-md-4">
                    <div class="vz-card">
                        <h3 class="vz-card-title">Sign up to help</h3>
                        <p class="vz-card-text">Choose events to support and keep track of your signups.</p>
                    </div>
                </article>
            </div>
        </section>
    </main>
</div>

<script>
    (function () {
        var root = document.documentElement;
        var toggle = document.getElementById('vz-theme-toggle');
        if (!toggle) { return; }

        function sync() {
            var isDark = root.getAttribute('data-bs-theme') === 'dark';
            toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        }

        toggle.addEventListener('click', function () {
            var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-bs-theme', next);
            try { localStorage.setItem('vazlr-theme', next); } catch (e) { /* storage unavailable */ }
            sync();
        });

        sync();
    })();
</script>